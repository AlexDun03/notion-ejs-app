<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/styles/students.css">
</head>
<div class="students-wrapper">
    <section>
        <%- include('./partials/newStudentForm.ejs') %>
    </section>
    <section>
        <%if( students!==null &&students!==undefined ){%>
            <div class="students">

                <%for(let student in students){%>
                    <div class="name">
                        <%= students[student].name%>
                    </div>
                    <div class="price">
                        <%= students[student].price%>
                    </div>
                    <div class="time">
                        <%= students[student].lessonTime%>
                    </div>
                    <div class="student-img">
                        <img src="<%= students[student].img%>" alt="">

                    </div>
                    <div class="subject">
                        <%for(let s of students[student].subjects ){%>
                            <%=s.name%>
                                <%}%>
                    </div>
                    <div class="email">
                        <%= students[student].email%>

                    </div>
                    <%}%>
            </div>
            <%}%>
    </section>
</div>